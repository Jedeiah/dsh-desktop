# macOS
.DS_Store

# Rust / Tauri 构建产物
target/
apps/desktop/src-tauri/gen/

# 打包时生成/拷贝的内置运行时（node/npm/pnpm-bin，可再生成，体积大不入库）
# 保留 resources/.gitkeep 占位，让 tauri-build 的 resources glob 在空检出时也能匹配
apps/desktop/src-tauri/resources/*
!apps/desktop/src-tauri/resources/.gitkeep

# 构建脚本输出
build/

# NSIS 钩子编译检查的产物（nsis-hooks-check.nsi，本地跑 makensis 时会落在脚本旁边）
apps/desktop/src-tauri/hook-check.exe

# 编辑器/系统临时
*.swp
*.tmp

# Reasonix 会话产物（截图/任务日志），不入库
.reasonix/

# 推广素材与作战文档（本地目录，不入库；生成脚本在 scripts/ 下）
promo/

# Python 缓存（scripts/ 下的推广与迁移脚本）
__pycache__/

# 本地调试产物（截图/会话），不入库
.devshots/
.superpowers/
